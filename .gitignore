# ============================================================
#  ShadowDrop - Security Edition
#  Developer : ATHEX BLACK HAT
#  Version   : 1.0.0
#  Purpose   : Ignore build artifacts, secrets, and local configs
# ============================================================


# ------------------------------------------------------------
#  🔴 CRITICAL - NEVER COMMIT THESE
# ------------------------------------------------------------

# Real lab configs (contain actual IPs / URLs / credentials)
configs/*.json
!configs/example_config.json
!configs/*.example.json

# Build outputs (real droppers - sensitive)
output/*
!output/.gitkeep

# Build logs (may contain target info)
logs/*
!logs/.gitkeep

# Temp build workspace
temp/*
!temp/.gitkeep

# Environment files
.env
.env.*
!.env.example

# Secrets / keys
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# Payloads (never commit actual payloads)
payloads/
*.payload
*.stager
*.bin


# ------------------------------------------------------------
#  🐍 PYTHON
# ------------------------------------------------------------

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
