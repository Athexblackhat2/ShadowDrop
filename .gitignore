# ------------------------------------------------------------
#  🔧 PROJECT-SPECIFIC
# ------------------------------------------------------------

# Compiled dropper outputs (keep folder, ignore contents)
output/*.exe
output/*.py
output/*.bin

# Generated source (temp)
dropper_source.py
cleanup.bat

# Build artifacts
*.log
build_*.log

# Local test scripts
test_*.py
!tests/test_*.py

# Notes (private)
NOTES.md
TODO.local.md
*.local.md


# ------------------------------------------------------------
#  📋 KEEP THESE FILES (even if pattern matches)
# ------------------------------------------------------------

!.gitignore
!.gitkeep
!README.md
!LICENSE
!requirements.txt
!builder.py

# Keep folder placeholders
!output/.gitkeep
!logs/.gitkeep
!temp/.gitkeep
!configs/example_config.json
!assets/icons/.gitkeep
!assets/version_info/.gitkeep